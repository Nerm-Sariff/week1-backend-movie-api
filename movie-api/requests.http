### Get all movies
GET http://localhost:3000/movies

### Get movie by ID
GET http://localhost:3000/movies/1

### Movie that does not exist
GET http://localhost:3000/movies/999

### Create a new movie
POST http://localhost:3000/movies
Content-Type: application/json

{
  "title": "Blade Runner",
  "director": "Ridley Scott",
  "year": 1982
}

### Invalid movie
POST http://localhost:3000/movies
Content-Type: application/json

{
  "director": "Nobody"
}

### Update a movie
PATCH http://localhost:3000/movies/2
Content-Type: application/json

{
  "year": 2011
}

### Delete a movie
DELETE http://localhost:3000/movies/6

### Get one movie
GET http://localhost:3000/movies/1

### Get a missing movie
GET http://localhost:3000/movies/999

### Create a valid movie
POST http://localhost:3000/movies
Content-Type: application/json

{
  "title": "Arrival",
  "year": 2016,
  "genre": "Sci-Fi"
}

### Create an invalid movie
POST http://localhost:3000/movies
Content-Type: application/json

{
  "title": "",
  "year": "not a number"
}

### Replace a movie
PUT http://localhost:3000/movies/1
Content-Type: application/json

{
  "title": "The Matrix",
  "year": 1999,
  "genre": "Sci-Fi"
}

### Invalid incomplete PUT
PUT http://localhost:3000/movies/1
Content-Type: application/json

{
  "title": "The Matrix"
}

### Partially update a movie
PATCH http://localhost:3000/movies/1
Content-Type: application/json

{
  "year": 2000
}

### Filter and sort movies
GET http://localhost:3000/movies?genre=Sci-Fi&minYear=2000&sort=year

### Invalid query parameter
GET http://localhost:3000/movies?minYear=invalid

### Delete a movie
DELETE http://localhost:3000/movies/1

### Delete the same movie again
DELETE http://localhost:3000/movies/1

### Unknown route
GET http://localhost:3000/does-not-exist